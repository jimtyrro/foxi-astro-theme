---
// Basic Cards grid Section
// ------------
// Description: A grid of cards with basic contact information in a 4 column layout.
// Properties:
// - title, description: section heading text (title may contain inline HTML, e.g. <strong>)
// - items: array of { icon, title, description } — one per card
// - classes: Additional classes to be added to the Section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/BasicCard.astro'

// Props
type Props = {
	title?: string
	description?: string
	items?: { iconName: string; title: string; description: string }[]
	classes?: string
}
const {
	title = 'Have a Special Request? We’re Here to <strong>Help!</strong>',
	description = "Choose from one of the options below to get the specific help you need. Whether it's customer support, sales inquiries, feature requests, or general feedback, we're here to provide you with the best assistance possible.",
	items = [
		{
			iconName: 'rocket',
			title: 'Customer Support',
			description:
				'Need help with Foxi? Our support team is available 24/7 to assist you with any issues or questions you might have.'
		},
		{
			iconName: 'document-text',
			title: 'Sales Inquiries',
			description:
				'Interested in our plans or want a custom solution? Get in touch with our sales team to find the perfect fit.'
		},
		{
			iconName: 'bolt',
			title: 'Feature Requests',
			description:
				'Have an idea to make Foxi even better? We’d love to hear from you! Share your feature requests and help us improve'
		},
		{
			iconName: 'chat-bubble-left-ellipsis',
			title: 'General Feedback',
			description:
				'Your feedback is invaluable to us. Let us know how we’re doing and how we can improve.'
		}
	],
	classes
} = Astro.props
---

<Section id="requests" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-balance" set:html={title} />
			<p class="pb-0 text-lg">{description}</p>
		</Col>
	</Row>
	<Row>
		{
			items.map((item) => (
				<Col span="3">
					<Card
						title={item.title}
						subtitle={item.description}
						icon={item.iconName}
						classes="h-full text-center dark:!bg-neutral-800/50"
						link="/contact"
					/>
				</Col>
			))
		}
	</Row>
</Section>
