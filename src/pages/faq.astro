---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import TextImage from '../components/blocks/basic/TextImage.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Data
import { getCollection, getEntry } from 'astro:content'
// - FAQ entries from the content collection, file order (NN- prefix) preserved
const faqEntries = (await getCollection('faq')).sort((a, b) => a.id.localeCompare(b.id))
const faqPricing = faqEntries.filter((e) => e.data.category === 'pricing').map((e) => e.data)
const faqIntegrations = faqEntries
	.filter((e) => e.data.category === 'integrations')
	.map((e) => e.data)

// Content
// - Page content (SEO + header) from the pages collection
const page = (await getEntry('pages', 'faq'))!
const {
	title: SEOTitle,
	description: SEODescription,
	header,
	cta,
	faqStickyTop,
	faqStickyBottom,
	textImageBlock
} = page.data
---

<Layout title={SEOTitle} description={SEODescription}>
	<Hero title={header?.title} text={header?.text} />
	<FAQ title={faqStickyTop?.title} text={faqStickyTop?.text} data={faqPricing} />
	<TextImage
		title={textImageBlock?.title}
		text={textImageBlock?.text}
		image={textImageBlock?.image}
		mobileImage={textImageBlock?.image}
		imagePosition="left"
		offsetImage
		classes="bg-neutral-50 dark:bg-neutral-900 lg:!py-64"
	/>
	<FAQ title={faqStickyBottom?.title} text={faqStickyBottom?.text} data={faqIntegrations} />
	<CTA title={cta?.title} description={cta?.description} award={cta?.award} button={cta?.button} />
</Layout>
