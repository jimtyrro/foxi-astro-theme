---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import FormHero from '../components/blocks/hero/ContactHero.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import ContactCards from '../components/blocks/contact/ContactCards.astro'
import SocialProof from '../components/blocks/socialproof/Basic.astro'

// Content
// - Page content (SEO + header + cta) from the pages collection
import { getEntry } from 'astro:content'
const page = (await getEntry('pages', 'contact'))!
const { title: SEOTitle, description: SEODescription, header, cta, cards } = page.data
---

<Layout title={SEOTitle} description={SEODescription}>
	<FormHero
		title={header?.title}
		text={header?.text}
		id="contact"
		classes="bg-neutral-50 dark:bg-neutral-950/80"
	/>
	<ContactCards
		title={cards?.title}
		description={cards?.description}
		items={cards?.items}
		classes="dark:bg-neutral-950/80"
	/>
	<SocialProof classes="dark:bg-neutral-950/80" />
	<CTA title={cta?.title} description={cta?.description} award={cta?.award} button={cta?.button} />
</Layout>
